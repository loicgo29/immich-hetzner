# === IMMICH — Hetzner Deployment ===
# Instance éphémère pour vérifier la restauration des photos
# À renseigner depuis Bitwarden « hetzner-immich »

# Database
DB_USER=immich
DB_PASSWORD=CHANGE_ME_FROM_BITWARDEN
DB_NAME=immich

# Immich API Key (généré lors du premier accès)
IMMICH_API_KEY=

# Storage paths (sur Hetzner : /donnees/immich/*)
IMMICH_UPLOAD_LOCATION=/donnees/immich/library

# Storage Box credentials (SFTP pour rclone)
STORAGE_BOX_USER=u575742
STORAGE_BOX_HOST=u575742.your-storagebox.de
STORAGE_BOX_PORT=23
STORAGE_BOX_SSH_KEY=/home/deploy/.ssh/id_ed25519_storagebox
STORAGE_BOX_DIR=immich-backup/h52hfhonpla8fvsmhfd7uiv7lg/mbulfur0om0kidtluojlmsso4c/dp876jfm84km526e39ntbe3irs/r27f76kcv4fe2pog23i34a82kg

# Photo archive details
PHOTO_ARCHIVE_NAME=immich-files-20260703-143501.tar.gz
PHOTO_ARCHIVE_SIZE=2386598516452

# DB dump details
DB_DUMP_PATTERN=immich-db-*.sql.gz

# Verification
VERIFICATION_ENABLED=true
VERIFICATION_REPORT_PATH=/donnees/immich/verification-report.json
