# === IMMICH — Hetzner Production ===
# À remplir depuis Bitwarden « hetzner-immich »
# NE PAS commiter cette fichier avec des vraies valeurs

# ─────────────────────────────────────────────────────────────────
# Database PostgreSQL
# ─────────────────────────────────────────────────────────────────
DB_USER=immich
DB_PASSWORD=REMPLACER_PAR_VALEUR_BITWARDEN
DB_NAME=immich

# ─────────────────────────────────────────────────────────────────
# Immich Configuration
# ─────────────────────────────────────────────────────────────────
# Sera généré lors du premier accès à l'interface web
IMMICH_API_KEY=

# Chemin du stockage sur le volume /donnees
IMMICH_UPLOAD_LOCATION=/donnees/immich/library

# ─────────────────────────────────────────────────────────────────
# Storage Box Hetzner (SFTP)
# ─────────────────────────────────────────────────────────────────
STORAGE_BOX_USER=u575742
STORAGE_BOX_HOST=u575742.your-storagebox.de
STORAGE_BOX_PORT=23
STORAGE_BOX_DIR=backup-aout-2026
STORAGE_BOX_SSH_KEY=/root/.ssh/id_ed25519_storagebox

# ─────────────────────────────────────────────────────────────────
# Photos Archive Details
# ─────────────────────────────────────────────────────────────────
PHOTO_ARCHIVE_NAME=immich-files-20260703-143501.tar.gz
PHOTO_ARCHIVE_SIZE=2400000000000

# ─────────────────────────────────────────────────────────────────
# Database Dump Details
# ─────────────────────────────────────────────────────────────────
DB_DUMP_PATTERN=immich-db-*.sql.gz

# ─────────────────────────────────────────────────────────────────
# Verification & Reporting
# ─────────────────────────────────────────────────────────────────
VERIFICATION_ENABLED=true
VERIFICATION_REPORT_PATH=/donnees/immich/verification-report.json
