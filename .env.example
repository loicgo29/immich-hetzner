# === IMMICH — Local Development ===

# Database
DB_USER=immich
DB_PASSWORD=immich_local_dev
DB_NAME=immich

# Immich API Key
IMMICH_API_KEY=

# Storage path (local)
IMMICH_UPLOAD_LOCATION=./volumes/immich/library

# Storage Box credentials (for testing restore)
STORAGE_BOX_USER=u575742
STORAGE_BOX_HOST=u575742.your-storagebox.de
STORAGE_BOX_PORT=23
STORAGE_BOX_DIR=backup-aout-2026

# SSH key for Storage Box
STORAGE_BOX_SSH_KEY=$HOME/.ssh/id_ed25519_storagebox

# Photo archive
PHOTO_ARCHIVE_NAME=immich-files-20260703-143501.tar.gz
PHOTO_ARCHIVE_SIZE=2400000000000

# DB dump
DB_DUMP_PATTERN=immich-db-*.sql.gz
