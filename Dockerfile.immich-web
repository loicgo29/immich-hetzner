FROM ghcr.io/immich-app/immich-web:release

# Fix hardcoded server URL in all JavaScript files
# Replace old docker network address with correct hostname
RUN find /app -name "*.js" -type f -exec sed -i \
    -e 's|localhost:3001|immich-server:2283|g' \
    -e 's|127\.0\.0\.1:3001|immich-server:2283|g' \
    -e 's|172\.[0-9]\+\.[0-9]\+\.[0-9]\+:3001|immich-server:2283|g' \
    {} +
